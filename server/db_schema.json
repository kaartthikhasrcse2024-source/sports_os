        "is_nullable": "YES",
        "column_default": null
      },
      {
        "column_name": "city",
        "data_type": "text",
        "is_nullable": "YES",
        "column_default": null
      },
      {
        "column_name": "area",
        "data_type": "text",
        "is_nullable": "YES",
        "column_default": null
      },
      {
        "column_name": "preferred_sport",
        "data_type": "text",
        "is_nullable": "YES",
        "column_default": null
      },
      {
        "column_name": "playing_position",
        "data_type": "text",
        "is_nullable": "YES",
        "column_default": null
      },
      {
        "column_name": "skill_level",
        "data_type": "text",
        "is_nullable": "YES",
        "column_default": null
      },
      {
        "column_name": "registration_status",
        "data_type": "text",
        "is_nullable": "NO",
        "column_default": "'INCOMPLETE'::text"
      },
      {
        "column_name": "created_at",
        "data_type": "timestamp with time zone",
        "is_nullable": "NO",
        "column_default": "now()"
      },
      {
        "column_name": "updated_at",
        "data_type": "timestamp with time zone",
        "is_nullable": "NO",
        "column_default": "now()"
      }
    ],
    "constraints": [
      {
        "conname": "player_age_valid",
        "contype": "c",
        "pg_get_constraintdef": "CHECK (((age IS NULL) OR ((age >= 5) AND (age <= 100))))"
      },
      {
        "conname": "player_registrations_pkey",
        "contype": "p",
        "pg_get_constraintdef": "PRIMARY KEY (user_id)"
      },
      {
        "conname": "player_registrations_registration_status_check",
        "contype": "c",
        "pg_get_constraintdef": "CHECK ((registration_status = ANY (ARRAY['INCOMPLETE'::text, 'SUBMITTED'::text, 'APPROVED'::text, 'REJECTED'::text])))"
      },
      {
        "conname": "player_registrations_user_id_fkey",
        "contype": "f",
        "pg_get_constraintdef": "FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE"
      }
    ],
    "indexes": [
      {
        "indexname": "player_registrations_pkey",
        "indexdef": "CREATE UNIQUE INDEX player_registrations_pkey ON public.player_registrations USING btree (user_id)"
      }
    ]
  },
